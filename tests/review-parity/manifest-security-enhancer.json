[
  {
    "name": "security_context",
    "description": "Inspect the immutable outgoing range. Start with inventory (it lists the surfaces the static stage already reported), then diff every changed file to its end; read is 400 lines with start; find is a literal search over the range. Credential containers are unavailable by design.",
    "parameters": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "inventory",
            "list",
            "diff",
            "read",
            "find"
          ]
        },
        "path": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "start": {
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        },
        "revision": {
          "type": "string",
          "enum": [
            "outgoing",
            "base"
          ]
        }
      },
      "required": [
        "operation"
      ]
    }
  },
  {
    "name": "security_submit_review",
    "description": "Submit the final hardening verdict once, with all seven domains accounted for.",
    "parameters": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "pass",
            "block",
            "incomplete"
          ]
        },
        "summary": {
          "type": "string"
        },
        "coverage": {
          "type": "object",
          "properties": {
            "dependency_supply_chain": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "reviewed",
                    "not-applicable",
                    "unknown"
                  ]
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "status",
                "reason"
              ],
              "additionalProperties": false
            },
            "ci_workflow_authority": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "reviewed",
                    "not-applicable",
                    "unknown"
                  ]
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "status",
                "reason"
              ],
              "additionalProperties": false
            },
            "secret_handling": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "reviewed",
                    "not-applicable",
                    "unknown"
                  ]
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "status",
                "reason"
              ],
              "additionalProperties": false
            },
            "transport_security": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "reviewed",
                    "not-applicable",
                    "unknown"
                  ]
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "status",
                "reason"
              ],
              "additionalProperties": false
            },
            "authz_defaults": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "reviewed",
                    "not-applicable",
                    "unknown"
                  ]
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "status",
                "reason"
              ],
              "additionalProperties": false
            },
            "container_runtime": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "reviewed",
                    "not-applicable",
                    "unknown"
                  ]
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "status",
                "reason"
              ],
              "additionalProperties": false
            },
            "release_artifacts": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "reviewed",
                    "not-applicable",
                    "unknown"
                  ]
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "status",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "dependency_supply_chain",
            "ci_workflow_authority",
            "secret_handling",
            "transport_security",
            "authz_defaults",
            "container_runtime",
            "release_artifacts"
          ],
          "additionalProperties": false
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "severity": {
                "type": "string",
                "enum": [
                  "blocking",
                  "advisory"
                ]
              },
              "evidence": {
                "type": "string"
              },
              "impact": {
                "type": "string"
              },
              "remedy": {
                "type": "string"
              },
              "validation": {
                "type": "string"
              }
            },
            "required": [
              "file",
              "line",
              "severity",
              "evidence",
              "impact",
              "remedy",
              "validation"
            ],
            "additionalProperties": false
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "verdict",
        "summary",
        "coverage",
        "findings",
        "unknowns"
      ]
    }

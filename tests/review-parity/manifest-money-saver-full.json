[
  {
    "name": "money_context",
    "description": "Inspect immutable source. Start with inventory for review mode and scope. Commit mode requires every changed diff; full mode requires original_request and per-project coverage. read is 400 lines with start; find/list use pattern glob and offset pagination. Full-mode find supports literal alternatives separated by |.",
    "parameters": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "inventory",
            "original_request",
            "list",
            "diff",
            "read",
            "find"
          ]
        },
        "path": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "start": {
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        },
        "revision": {
          "type": "string",
          "enum": [
            "staged",
            "base"
          ]
        }
      },
      "required": [
        "operation"
      ]
    }
  },

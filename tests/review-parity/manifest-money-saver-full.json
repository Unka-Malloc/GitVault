  {
    "name": "money_submit_review",
    "description": "Submit the final cost decision once. Follow the Money Saver policy's evidence and coverage contract.",
    "parameters": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "pass",
            "block",

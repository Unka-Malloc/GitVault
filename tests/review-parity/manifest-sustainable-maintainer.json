              ],
              "additionalProperties": false
            },
            "duplication": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "reviewed",
                    "not-applicable",
                    "unknown"
                  ]
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "status",
                "reason"
              ],
              "additionalProperties": false
            },
            "tests": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "reviewed",
                    "not-applicable",
                    "unknown"
                  ]
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "status",

[
  {
    "name": "maintainer_context",
    "description": "Inspect the immutable outgoing range. Start with inventory, then diff every changed file to its end; read is 400 lines with start and revision; list globs the snapshot; find is a literal search over the range — use it to locate the original a change duplicates, the callers a contract serves, or the documentation a decision should update. Credential containers are unavailable by design.",
    "parameters": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "inventory",
            "list",
            "diff",
            "read",
            "find"
          ]
        },
        "path": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "start": {
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        },
        "revision": {
          "type": "string",
          "enum": [
            "outgoing",
            "base"
          ]
        }
      },
      "required": [
        "operation"
      ]
    }
  },
  {
